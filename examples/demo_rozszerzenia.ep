// Stare: const
📌
    MAX 🟰 1️⃣0️⃣0️⃣ 🔹
    ETYKIETA 🟰 "demo" 🔹

// Stare + nowe: var (int, bool, string, tablica, real, char, record)
📦
    i 📍 🔢 🔹
    suma 📍 🔢 🔹
    ok 📍 ✅ 🔹
    tekst 📍 🧵 🔹
    waga 📍 🌊 🔹
    sr 📍 🌊 🔹
    znak 📍 🔡 🔹
    liczby 📍 📚 🤜 1️⃣ ↔️ 3️⃣ 🤛 🧾 🔢 🔹
    punkt 📍 🧱 🚦
        x 📍 🔢 🔹
        y 📍 🔢 🔹
    🛑 🔹

// Nowe: BYREF (📤)
🔧 Zwieksz 🤜 📤 v 📍 🔢 🤛 🔹
🚦
    v ⬅️ v ➕ 1️⃣ 🔹
